// Prisma schema for the workspace app.
// Auth.js (NextAuth) owns User/Account/Session/VerificationToken; the extra
// columns on User are what the app itself needs (role, designation, billing rate).

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// How the app renders for one person. Stored per account so the choice
/// follows them to another browser or device, unlike a local preference.
/// SYSTEM means "no class on <html>", which lets the prefers-color-scheme
/// block in globals.css decide.
enum Theme {
  LIGHT
  DARK
  SYSTEM
}

/// Workspace roles, ordered most to least privileged. Scoped per membership,
/// not per user — the same person can hold a different role in each workspace.
enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
  GUEST
}

/// A tenant. Every Project, Message and ActivityEntry belongs to
/// exactly one workspace; a User can belong to several via WorkspaceMember.
model Workspace {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         WorkspaceMember[]
  projects        Project[]
  activity        ActivityEntry[]
  messages        Message[]
  customRoles     CustomRole[]
  labels          Label[]
  notifications   Notification[]
  events          Event[]
  invitations     Invitation[]
  removals        MemberRemoval[]
  lastActiveUsers User[]            @relation("LastWorkspace")

  @@index([slug])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// R2 object key behind `image`, kept so the old object can be deleted when
  /// the photo is replaced. Null when `image` is external or unset.
  imageKey      String?

  /// bcrypt hash. Null for accounts that only sign in through OAuth.
  passwordHash String?

  /// The workspace to resume into on the next sign-in. Not the source of
  /// truth for access — WorkspaceMember is — just a UX convenience.
  lastWorkspaceId String?
  designation     String?
  phone           String?
  hourlyRate      Int       @default(0)
  monthlyHours    Int       @default(160)
  joinedAt        DateTime  @default(now())
  lastLoginAt     DateTime?
  disabledAt      DateTime?
  /// Light by default: a deliberate, predictable starting point rather than
  /// inheriting whatever the operating system happens to be set to.
  theme           Theme     @default(LIGHT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  lastWorkspace        Workspace?        @relation("LastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMemberships WorkspaceMember[]
  projects             ProjectMember[]
  assignedTasks        TaskAssignee[]
  timeEntries          TimeEntry[]
  activity             ActivityEntry[]
  sentMessages         Message[]         @relation("MessageSender")
  receivedMessages     Message[]         @relation("MessageRecipient")
  assignedSheets       ProjectSheet[]    @relation("SheetAssignee")
  runningTimer         TaskTimer?
  uploadedAttachments  TaskAttachment[]  @relation("AttachmentUploader")
  assignedSubtasks     Subtask[]         @relation("SubtaskAssignee")
  notifications        Notification[]    @relation("NotificationRecipient")
  causedNotifications  Notification[]    @relation("NotificationActor")
  createdEvents        Event[]           @relation("EventCreator")
  managedMembers       WorkspaceMember[] @relation("MemberManager")
  sentInvitations      Invitation[]      @relation("InvitationSender")
  removalRecord        MemberRemoval[]   @relation("RemovedMember")
  removalsPerformed    MemberRemoval[]   @relation("MemberRemover")
  eventInvites         EventAttendee[]

  @@index([lastWorkspaceId])
}

/// A role an owner or admin defined, on top of the built-in `Role` enum.
///
/// `inheritsFrom` is mandatory and is what every role-based check reads: a
/// custom role IS its base role as far as guards are concerned, and the
/// `permissions` array only narrows what that base role grants. Without it a
/// holder would resolve to the least-privileged role and every gated route
/// would refuse them while the role still looked correct in the UI.
model CustomRole {
  id          String @id @default(cuid())
  workspaceId String
  /// Lowercase key, unique per workspace. Never collides with a base role name.
  name        String
  label       String
  description String @default("") @db.Text

  /// Permission keys from lib/permissions.ts, as a string array.
  permissions Json

  /// Page keys from `APP_PAGES` in lib/permissions.ts, as a string array — the
  /// pages a holder of this role may reach.
  ///
  /// Assigned, not derived: the list stands on its own rather than being read
  /// out of `permissions`, so an admin can hand a role a page whose permission
  /// it does not hold. Reaching a page and being able to act on it are two
  /// separate questions — the page gate asks this column, while every button
  /// and server action inside still asks `permissions`.
  ///
  /// Null on a row written before the column existed; resolution falls back to
  /// the permission-derived list for those, which is what they had before.
  pages Json?

  inheritsFrom Role
  isActive     Boolean @default(true)
  /// Reserved for roles the app ships; user-made roles are always false, which
  /// is what keeps Edit and Delete enabled for them.
  isSystem     Boolean @default(false)

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations Invitation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// A user's membership — and role — in one workspace. Role lives here, not
/// on User, so the same person can be an owner in one workspace and a guest
/// in another.
model WorkspaceMember {
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  /// Set when this member holds a custom role. `role` still carries the base
  /// role it inherits from, so a query filtering on `role` stays correct
  /// without having to join.
  customRoleId String?

  /// Who manages this person, as a user id, within this workspace.
  ///
  /// On the membership rather than on `User`: role, pages and custom roles are
  /// all per-workspace already, and somebody in two workspaces can answer to a
  /// different person in each.
  ///
  /// Null means nobody manages them yet, and that is deliberately *not* the
  /// same as being everyone’s: an unassigned member is visible to admins only
  /// until somebody is named. `SetNull` on delete, so removing a manager’s
  /// account releases their reports rather than deleting them.
  managerId String?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  manager    User?       @relation("MemberManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@id([workspaceId, userId])
  @@index([userId])
  @@index([customRoleId])
  /// The manager scope query: everyone reporting to one person in one workspace.
  @@index([workspaceId, managerId])
}

enum ProjectStatus {
  ACTIVE
  PLANNING
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CampaignStatus {
  ACTIVE
  DRAFT
  PAUSED
  COMPLETED
}

enum SectionType {
  HERO
  FEATURES
  CTA
  TESTIMONIALS
  GALLERY
  NEWSLETTER
  FAQ
}


model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String        @db.Text
  status      ProjectStatus @default(PLANNING)
  color       String
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  /// Enabled sub-pages, as a string array of ProjectFeature keys. Null means
  /// "never configured" — the app falls back to DEFAULT_PROJECT_FEATURES, so
  /// projects that predate this column keep the pages they already showed.
  features    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  tasks     Task[]
  campaigns Campaign[]
  sections  LandingSection[]
  sheets    ProjectSheet[]
  boards    Board[]
  events    Event[]

  @@index([workspaceId])
}

/// A Trello-style board. A project may have several; each holds its own lists.
model Board {
  id        String @id @default(cuid())
  projectId String
  name      String
  /// Order among the project's boards, so tabs keep a chosen sequence.
  position  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lists   BoardList[]

  @@index([projectId])
}

/// A column on a board.
///
/// Lists are named freely — "Backlog", "QA", "Waiting on client" — but each one
/// *counts as* one of the four task statuses. That mapping is what keeps
/// progress, Done counts, overdue warnings and every report correct: moving a
/// card onto a list sets the card's status to the list's, so `Task.status`
/// always agrees with where the card sits.
model BoardList {
  id       String     @id @default(cuid())
  boardId  String
  name     String
  status   TaskStatus
  /// Left-to-right order on the board.
  position Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
}

/// A free-form spreadsheet. A project may have several.
///
/// Deliberately unrelated to Task: a blank grid people type into, not a view
/// of anything else in the app. Cells are a row-major 2-D array of strings —
/// a sheet this size is read and written whole, so a row-per-cell table would
/// buy nothing and cost a join.
model ProjectSheet {
  id        String @id @default(cuid())
  projectId String
  name      String

  /// `string[][]`, row-major, exactly as typed: a formula is stored as its
  /// text ("=SUM(A1:A3)"), never as its result, so a stored sheet can never
  /// hold a value that disagrees with its own formula. Blanks are "".
  cells    Json
  /// Kept alongside the data so an empty grid still has a shape.
  rowCount Int  @default(20)
  colCount Int  @default(8)

  /// Per-cell formatting, keyed "row:col" — only formatted cells appear, so a
  /// mostly-plain sheet stays small. Null means nothing is formatted.
  formats    Json?
  /// Column widths in pixels, by index. Null means every column is default.
  colWidths  Json?
  /// Rows pinned to the top while scrolling — 0 or 1, as the UI offers it.
  frozenRows Int   @default(0)

  /// Who is responsible for this sheet. Nullable — a sheet need not be
  /// anyone's in particular. SetNull so removing a person leaves the sheet.
  assigneeId String?
  /// Manual order within the project, so tabs keep a stable, chosen sequence.
  position   Int     @default(0)

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("SheetAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assigneeId])
}

model ProjectMember {
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  title           String
  description     String     @default("") @db.Text
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  /// Estimate in whole minutes — durations are never fractional here.
  estimateMinutes Int        @default(0)
  dueDate         DateTime?  @db.Date
  /// Manual ordering within its list, top to bottom.
  position        Int        @default(0)
  /// R2 object key of the image drawn across the top of the card. Null for none.
  coverKey        String?

  /// The board list this card sits in. Its status always equals the list's.
  ///
  /// Nullable because tasks are also created where no board is in view (the
  /// workspace-wide Tasks page). Those land in a list the next time the
  /// project's boards are loaded — see `ensureProjectBoards` — rather than
  /// every create path having to know about boards. SetNull on delete for the
  /// same reason: a card whose list vanishes is re-homed, not lost.
  listId String?

  /// Set when the task is archived. Archived tasks leave the board but keep
  /// their time entries, so history stays intact — this is why archiving is
  /// offered instead of deletion.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  list        BoardList?       @relation(fields: [listId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  entries     TimeEntry[]
  labels      TaskLabel[]
  attachments TaskAttachment[]
  timers      TaskTimer[]
  subtasks    Subtask[]

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([listId])
}

/// A checklist item on a task — its own title and done state, but no status,
/// assignee or time tracking of its own. Kept lightweight on purpose: a task
/// that needs those belongs on the board as a task of its own.
/// A node in a task's subtask tree. Nests to any depth: a subtask can have
/// subtasks of its own.
///
/// Every node keeps `taskId`, not only the top level, so a whole tree loads
/// in one query and a task's deletion clears it in one cascade.
///
/// `parent` is SetNull rather than Cascade on purpose. MySQL gives up on
/// cascades nested deeper than 15 levels, so a self-referencing cascade would
/// make deep trees undeletable. Deleting a branch is done in application code
/// (collect the subtree, delete it together); this link only has to stay
/// valid while that happens.
model Subtask {
  id              String     @id @default(cuid())
  taskId          String
  /// Null for a top-level subtask.
  parentId        String?
  title           String
  description     String     @default("") @db.Text
  /// Who is doing it. SetNull, so removing a person leaves the subtask.
  assigneeId      String?
  status          TaskStatus @default(TODO)
  /// Optional, in whole minutes — what analytics compares logged time against.
  estimateMinutes Int        @default(0)
  /// Order among siblings, top to bottom.
  position        Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent      Subtask?         @relation("SubtaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Subtask[]        @relation("SubtaskTree")
  entries     TimeEntry[]
  timers      TaskTimer[]
  attachments TaskAttachment[]

  @@index([taskId])
  @@index([parentId])
  @@index([assigneeId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TimeEntry {
  id        String    @id @default(cuid())
  date      DateTime  @db.Date
  userId    String
  taskId    String
  /// Logged time in whole minutes.
  minutes   Int
  /// The wall-clock span this entry covers, when it is known: a timer always
  /// records both, a duration-only manual entry neither. `minutes` stays the
  /// authoritative duration so every existing sum keeps working unchanged.
  startedAt DateTime?
  endedAt   DateTime?
  note      String    @default("") @db.Text

  createdAt DateTime @default(now())

  /// The subtask this time was spent on, if any. The entry always belongs to
  /// `taskId` as well, so task totals and every report include it unchanged.
  subtaskId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// SetNull: deleting a subtask keeps the hours on the task.
  subtask Subtask? @relation(fields: [subtaskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([date])
  @@index([subtaskId])
}

model Campaign {
  id          String         @id @default(cuid())
  projectId   String
  name        String
  description String         @db.Text
  status      CampaignStatus @default(DRAFT)
  progress    Int            @default(0)
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  budget      Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model LandingSection {
  id           String      @id @default(cuid())
  projectId    String
  type         SectionType
  heading      String
  subheading   String?
  /// String array of bullet/feature copy.
  items        Json?
  primaryCta   String?
  secondaryCta String?
  position     Int         @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Message {
  id          String   @id @default(cuid())
  workspaceId String
  senderId    String
  recipientId String
  body        String   @db.Text
  sentAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender    User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([senderId])
  @@index([recipientId])
  @@index([sentAt])
}

model ActivityEntry {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  action      String
  target      String
  at          DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([at])
  @@index([userId])
}

/// Something one person should know about: a task assigned to them, a subtask
/// handed over, someone added to a project.
///
/// Addressed to a person *in a workspace*, so the bell only ever shows what
/// belongs to the workspace they are currently in. `readAt` is per row rather
/// than a single "last read" stamp, so marking one read leaves the rest alone.
model Notification {
  id          String  @id @default(cuid())
  workspaceId String
  /// Who it is for.
  userId      String
  /// Who caused it. Null when the app itself did.
  actorId     String?
  kind        String
  title       String
  body        String  @default("") @db.Text
  /// Where clicking it goes, as an in-app path.
  href        String  @default("")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, readAt])
  @@index([userId, createdAt])
  @@index([actorId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// The one timer a person currently has running.
///
/// Kept apart from TimeEntry rather than modelled as an entry with no end: the
/// unique index on `userId` is what makes "one timer per user" an invariant the
/// database enforces instead of a rule the UI hopes to hold, and it keeps
/// TimeEntry meaning "work that actually happened" — so every existing total,
/// report and timesheet stays correct without learning about running timers.
model TaskTimer {
  id        String    @id @default(cuid())
  userId    String    @unique
  taskId    String
  /// Elapsed time is always derived from this, never counted up in the client,
  /// so a refresh — or a different device — resumes at the right number.
  startedAt DateTime  @default(now())
  /// Set while paused; the clock is frozen at this moment. Resuming moves
  /// `startedAt` forward by the paused stretch, so `now - startedAt` is always
  /// the time actually worked.
  pausedAt  DateTime?
  note      String    @default("") @db.Text
  /// The subtask being timed, if any; carried onto the entry when it stops.
  subtaskId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// SetNull: deleting the subtask keeps the timer running on the task.
  subtask Subtask? @relation(fields: [subtaskId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([subtaskId])
}

/// A tag that can be put on tasks. Scoped to a workspace, so one tenant's
/// labels never leak into another's picker.
model Label {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#64748B")

  createdAt DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

/// An image attached to a task, stored in Cloudflare R2.
///
/// Only the object key is persisted, never the full URL: the public URL is that
/// key prefixed with `NEXT_PUBLIC_R2_PUBLIC_URL`, so putting the bucket behind
/// a different domain is a config change rather than a data migration.
///
/// `size`, `width` and `height` describe the object as *stored* — after sharp
/// has resized and re-encoded it — not the file that was chosen.
model TaskAttachment {
  id           String  @id @default(cuid())
  taskId       String
  /// Set when the file was added to a subtask. SetNull on delete: the file
  /// then stays on the task, the way a deleted subtask's logged time does.
  subtaskId    String?
  objectKey    String  @unique
  filename     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  uploadedById String?

  createdAt DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtask    Subtask? @relation(fields: [subtaskId], references: [id], onDelete: SetNull)
  uploadedBy User?    @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([subtaskId])
}

/// The deployment's own branding: logo, dark-mode logo, favicon.
///
/// A single row, pinned to id "app". Deliberately not per-workspace: the
/// favicon and the sign-in screen are rendered before anyone has chosen a
/// workspace — or signed in at all — so there is no tenant to read it from.
model AppSetting {
  id String @id @default("app")

  /// R2 object keys. Null means "fall back to the built-in wordmark".
  logoLightKey String?
  logoDarkKey  String?
  faviconKey   String?

  updatedAt DateTime @updatedAt
}

/// A dated entry on the shared calendar, alongside the task deadlines that
/// screen already draws.
///
/// The day is stored as a `@db.Date` like `Task.dueDate`, so it means the same
/// calendar square to everyone regardless of timezone. `startsAt` is the
/// separate, absolute instant the event begins — the reminder sweep needs a
/// real point in time to compare `now()` against, which a bare date cannot give.
model Event {
  id          String @id @default(cuid())
  workspaceId String
  /// Optional: an event may belong to one project, which is also what narrows
  /// the attendee picker to that project's members.
  projectId   String?

  title       String
  description String @default("") @db.Text

  /// The calendar square this sits on.
  date DateTime @db.Date
  /// Wall-clock start and end, as "HH:MM". Null on an all-day event.
  startTime String?
  endTime   String?

  /// `date` + `startTime` resolved to an instant, or midnight for an all-day
  /// event. Denormalised so the reminder sweep is one indexed range scan
  /// rather than a parse of every row.
  startsAt DateTime

  /// How long before `startsAt` the reminder goes out, in minutes.
  reminderMinutes Int @default(30)
  /// Stamped by the sweep once the reminder has gone out, so a second run
  /// cannot send it twice. Cleared when the time or the guest list changes.
  reminderSentAt DateTime?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attendees EventAttendee[]

  @@index([workspaceId, date])
  /// The reminder sweep's access path: unsent reminders, oldest first.
  @@index([reminderSentAt, startsAt])
  @@index([projectId])
  @@index([createdById])
}

/// Who is expected at an event. Mirrors `TaskAssignee`.
model EventAttendee {
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

/// An outstanding invitation to join a workspace.
///
/// No `User` row exists yet: the account is created when the invitation is
/// accepted, so the invitee chooses their own password and nobody — not even
/// the admin who invited them — ever knows it.
///
/// Distinct from `VerificationToken`, which is the Auth.js adapter's own shape
/// and carries no workspace or role.
model Invitation {
  id          String @id @default(cuid())
  workspaceId String
  /// Lowercased, matching how `authorize()` looks an account up.
  email       String
  /// The base role the membership is created with.
  role        Role
  /// The role row the membership should point at, resolved when the invitation
  /// is sent. Null for Admin, which is the one fixed role and has no row.
  customRoleId String?

  /// SHA-256 of the token, hex. The token itself only ever exists in the
  /// emailed URL — a leaked database gives no usable invitation links, the same
  /// reasoning that keeps passwords hashed.
  tokenHash String @unique

  expiresAt  DateTime
  /// Stamped on acceptance, which is what makes the link single-use.
  acceptedAt DateTime?
  /// Stamped when an admin withdraws it, so it is refused without being erased.
  revokedAt  DateTime?

  invitedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  invitedBy  User?       @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  /// The pending-invitations list: this workspace's, newest first.
  @@index([workspaceId, createdAt])
  /// Finding an outstanding invitation for an address before sending another.
  @@index([email])
  @@index([customRoleId])
  @@index([invitedById])
}

/// A record that somebody was taken off a workspace, and what they were
/// holding at the time.
///
/// Kept because the removal destroys the evidence: their `WorkspaceMember` and
/// `ProjectMember` rows are gone afterwards, so the counts below could not be
/// reconstructed from anything that remains. This is the history page's only
/// source.
///
/// The user row itself is untouched — removal takes somebody off a workspace,
/// it does not delete their account. `SetNull` on both people so the record
/// outlives either of them being deleted later; the snapshot names are what it
/// reads from in that case.
model MemberRemoval {
  id          String @id @default(cuid())
  workspaceId String

  /// Null once the account itself is deleted; `userName` still says who.
  userId    String?
  /// Captured at removal, because the account may be renamed or deleted after.
  userName  String
  userEmail String
  /// The role they held when they were removed.
  role      Role

  /// Why. Required — a removal with no stated reason is the one nobody can
  /// explain a year later.
  reason String @db.Text

  /// What they were holding, counted at the moment of removal.
  projectCount Int @default(0)
  hoursLogged  Float @default(0)

  removedById String?
  removedAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation("RemovedMember", fields: [userId], references: [id], onDelete: SetNull)
  removedBy User?     @relation("MemberRemover", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, removedAt])
  @@index([userId])
  @@index([removedById])
}
