# Copy to .env and fill in. Never commit the filled-in copy.

# --- Database --------------------------------------------------------------
# The discrete DB_* variables are the source of truth; buildDatabaseUrl() in
# src/lib/db-config/db-config.ts assembles them for the app, the Prisma CLI and
# the seed alike. DATABASE_URL is only a fallback for hosts that insist on it.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=projectmanagementapp

# Used only by `npm run db:seed`. SEED_PASSWORD is the admin's first password —
# without it the seed creates the workspace and roles but no account. Change it
# from inside the app afterwards; re-seeding never resets it.
SEED_PASSWORD=
SEED_ADMIN_EMAIL=admin@virtuosoft.com
SEED_ADMIN_NAME=Admin
# DATABASE_URL=mysql://user:password@host:3306/database

# --- Auth ------------------------------------------------------------------
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Generate one with: npx auth secret
AUTH_SECRET=

# --- Cloudflare R2 (images) ------------------------------------------------
# Backs task attachments, profile photos, the app logo and the favicon.
#
# Optional. Without all five the app runs exactly as before minus image
# uploads: each upload control explains that it is unconfigured rather than
# offering something that cannot work.
#
# R2_ACCOUNT_ID           Cloudflare dashboard → the account id in the URL.
# R2_ACCESS_KEY_ID        R2 → Manage API tokens → an Object Read & Write token.
# R2_SECRET_ACCESS_KEY    The secret half of that token. Shown once.
# R2_BUCKET               The bucket name.
# NEXT_PUBLIC_R2_PUBLIC_URL
#                         The bucket's public origin, no trailing slash — an
#                         r2.dev subdomain or your own custom domain. Public by
#                         nature: it prefixes every image URL the app serves,
#                         which is why it is the one NEXT_PUBLIC_ variable here.
#
# The bucket needs public read access (R2 → Settings → Public access) or the
# images will 404 for everyone but you. No CORS rules are needed: uploads go
# through this server, not from the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Calendar event reminders ----------------------------------------------
# The shared secret for /api/cron/event-reminders, the sweep that sends the
# "starts soon" notification for calendar events.
#
# Optional, and there is no scheduler in this app: nothing calls that route on
# its own. Set this, then have something outside the app call it on an
# interval — Task Scheduler, a systemd timer, your host's cron, whatever you
# already run:
#
#   curl -X POST http://localhost:3000/api/cron/event-reminders \
#        -H "Authorization: Bearer $CRON_SECRET"
#
# Leave it unset and the route refuses every request with 503, which is the
# safe default: it writes notifications for other people, so it must never be
# open. Write-time notifications (being added to an event, an event moving)
# do not depend on any of this and work regardless.
#
# Generate one with: npx auth secret
CRON_SECRET=

# --- SMTP (email invitations) ----------------------------------------------
# Backs "Invite by email" on Administration → Users, which emails a link the
# invitee uses to choose their own password.
#
# Optional, and all-or-nothing: without SMTP_HOST and SMTP_FROM the invite
# button is disabled and says so, rather than writing an invitation nobody can
# receive. SMTP_USER / SMTP_PASSWORD may be omitted for a relay that needs no
# credentials (a local Mailpit or MailHog, say).
#
# SMTP_PORT defaults to 587. SMTP_SECURE defaults to true only on port 465
# (implicit TLS); 587 upgrades with STARTTLS on its own. Set it explicitly only
# if your relay disagrees.
#
# The invitation link is built from APP_URL (falling back to AUTH_URL), never
# from the request's Host header — so set APP_URL to the real public origin or
# invitees will be sent to localhost.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Acme Corp <no-reply@example.com>"
